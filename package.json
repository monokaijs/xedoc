{
  "name": "xedoc-cli",
  "version": "0.1.25",
  "description": "Local web UI for Codex account, chat, execution, and workspace management.",
  "author": "Edward Nguyen <monokaijs@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monokaijs/xedoc.git"
  },
  "bin": {
    "xedoc": "bin/xedoc.mjs"
  },
  "files": [
    "bin/xedoc.mjs",
    "build/client/",
    "build/server/index.js",
    "prisma/schema.prisma",
    "server/index.mjs",
    "server/terminal-socket.mjs",
    "server/sqlite-setup.mjs",
    "server/workflow-mcp.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build --mode production --minify terser",
    "start": "node ./server/index.mjs",
    "typecheck": "tsc --noEmit",
    "clean:build": "node -e \"import('node:fs/promises').then(({ rm }) => rm('build', { recursive: true, force: true }))\"",
    "prepublishOnly": "pnpm prisma:generate && pnpm typecheck",
    "prepack": "pnpm clean:build && pnpm build",
    "publish:npm": "npm publish --access public",
    "publish:dry-run": "npm publish --access public --dry-run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:setup": "node -e \"import('./server/sqlite-setup.mjs').then((m)=>m.setupSqliteDatabase())\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@lydell/node-pty": "1.1.0",
    "@openai/codex": "^0.130.0",
    "@prisma/client": "^6.19.3",
    "@react-router/node": "^7.15.1",
    "@tanstack/react-query": "^5.100.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "16.6.1",
    "ghostty-web": "^0.4.0",
    "highlight.js": "^11.11.1",
    "isbot": "^5.1.32",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.15.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.47.1",
    "typescript": "5.9.3",
    "vite": "^8.0.12"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  }
}
